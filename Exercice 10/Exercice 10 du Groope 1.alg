<?xml version="1.0" encoding="UTF-8"?>
<Algo>
    <description courant="FIN_SINON" texte=""/>
    <extension extnom="inactif"/>
    <fonction fctcode="" fctetat="inactif"/>
    <F2 F2defaut="" F2etat="inactif" F2lignes="" F2para=""/>
    <repere repcode="-10#10#-10#10#2#2" repetat="inactif"/>
    <param arrondiAuto="vrai" epaisseurLigne="2" epaisseurPoint="2" maxBoucle="500000" nbDecimales="8" totalAffichages="1000" totalBoucles="5000000"/>
    <item algoitem="FONCTIONS_UTILISEES" code="200#declarationfonctions">
        <item algoitem="FONCTION f1(trajets)" code="201#f1#trajets">
            <item algoitem="VARIABLES_FONCTION" code="202#declarationsvariablesfonction">
                <item algoitem="f EST_DU_TYPE NOMBRE" code="1#NOMBRE#f"/>
            </item>
            <item algoitem="DEBUT_FONCTION" code="203#debutfonction"/>
            <item algoitem="f PREND_LA_VALEUR trajets*1000" code="5#f#trajets*1000#pasliste"/>
            <item algoitem="RENVOYER f" code="205#f"/>
            <item algoitem="FIN_FONCTION" code="204#finfonction"/>
        </item>
    </item>
    <item algoitem="VARIABLES" code="100#declarationsvariables">
        <item algoitem="age EST_DU_TYPE NOMBRE" code="1#NOMBRE#age"/>
        <item algoitem="r EST_DU_TYPE NOMBRE" code="1#NOMBRE#r"/>
        <item algoitem="trajets EST_DU_TYPE NOMBRE" code="1#NOMBRE#trajets"/>
    </item>
    <item algoitem="DEBUT_ALGORITHME" code="101#debutalgo">
        <item algoitem="AFFICHER &quot;Bienvenue sur tarif de bus&quot;" code="4#Bienvenue sur tarif de bus#1"/>
        <item algoitem="AFFICHER &quot;Veillez entrer votre age&quot;" code="4#Veillez entrer votre age#0"/>
        <item algoitem="LIRE age" code="2#age#pasliste"/>
        <item algoitem="AFFICHER &quot;Veillez entrer votre trajets&quot;" code="4#Veillez entrer votre trajets#0"/>
        <item algoitem="LIRE trajets" code="2#trajets#pasliste"/>
        <item algoitem="TANT_QUE (age&lt;0) FAIRE" code="15#age&lt;0">
            <item algoitem="DEBUT_TANT_QUE" code="16#debuttantque"/>
            <item algoitem="AFFICHER &quot;invalide&quot;" code="4#invalide#1"/>
            <item algoitem="LIRE age" code="2#age#pasliste"/>
            <item algoitem="FIN_TANT_QUE" code="17#fintantque"/>
        </item>
        <item algoitem="SI (age&lt;5) ALORS" code="6#age&lt;5">
            <item algoitem="DEBUT_SI" code="7#debutsi"/>
            <item algoitem="AFFICHER &quot;gratuit&quot;" code="4#gratuit#1"/>
            <item algoitem="r PREND_LA_VALEUR f1(trajets)*0" code="5#r#f1(trajets)*0#pasliste"/>
            <item algoitem="AFFICHER r" code="3#r#0#pasliste"/>
            <item algoitem="AFFICHER &quot;F&quot;" code="4#F#0"/>
            <item algoitem="FIN_SI" code="8#finsi"/>
            <item algoitem="SINON" code="9#sinon">
                <item algoitem="DEBUT_SINON" code="10#debutsinon"/>
                <item algoitem="SI (age&lt;=17 ou age>=60) ALORS" code="6#age&lt;=17 ou age>=60">
                    <item algoitem="DEBUT_SI" code="7#debutsi"/>
                    <item algoitem="AFFICHER &quot;demi tarif&quot;" code="4#demi tarif#1"/>
                    <item algoitem="r PREND_LA_VALEUR f1(trajets)/2" code="5#r#f1(trajets)/2#pasliste"/>
                    <item algoitem="AFFICHER r" code="3#r#0#pasliste"/>
                    <item algoitem="AFFICHER &quot;F&quot;" code="4#F#0"/>
                    <item algoitem="FIN_SI" code="8#finsi"/>
                    <item algoitem="SINON" code="9#sinon">
                        <item algoitem="DEBUT_SINON" code="10#debutsinon"/>
                        <item algoitem="SI (age&lt;=59) ALORS" code="6#age&lt;=59">
                            <item algoitem="DEBUT_SI" code="7#debutsi"/>
                            <item algoitem="AFFICHER &quot;plein tarif&quot;" code="4#plein tarif#1"/>
                            <item algoitem="r PREND_LA_VALEUR f1(trajets)" code="5#r#f1(trajets)#pasliste"/>
                            <item algoitem="AFFICHER r" code="3#r#0#pasliste"/>
                            <item algoitem="AFFICHER &quot;F&quot;" code="4#F#0"/>
                            <item algoitem="FIN_SI" code="8#finsi"/>
                        </item>
                        <item algoitem="FIN_SINON" code="11#finsinon"/>
                    </item>
                </item>
                <item algoitem="FIN_SINON" code="11#finsinon"/>
            </item>
        </item>
    </item>
    <item algoitem="FIN_ALGORITHME" code="102#finalgo"/>
</Algo>
